# Copy to .env for local development (untracked — never commit real values).
# On hosting platforms (Render/Railway/Fly) set these as real env vars instead.

# App callback base: the app's /api/verify/stream-detected endpoint.
# /stream-ready and /stream-failed are derived by replacing the trailing
# path segment (or set STREAM_READY_URL / STREAM_FAILED_URL explicitly).
CALLBACK_URL=https://your-app.example.com/api/verify/stream-detected
# STREAM_READY_URL=https://your-app.example.com/api/verify/stream-ready
# STREAM_FAILED_URL=https://your-app.example.com/api/verify/stream-failed

# Optional lifecycle-event sink (stream_stopped/error/timeout). Not derived.
# APP_EVENTS_URL=https://your-app.example.com/api/verify/stream-event

# Shared secret; must equal the app's VERIFY_STREAM_SECRET. Used for the
# x-verify-secret header AND to validate per-session stream tokens:
#   token = hex(HMAC-SHA256(STREAM_SECRET, "merge-relay-stream:" + sid))
# Generate a fresh random value (e.g. `openssl rand -hex 24`) — do NOT
# reuse any secret that was ever committed to git history.
STREAM_SECRET=replace-with-a-fresh-random-secret

# Session state persistence (atomic tmp-write + rename).
# STATE_FILE=./relay-state.json

# Demo TwiML endpoints (/twiml/*) are DISABLED unless explicitly enabled:
# DEMO_TWIML=1

# Tunables (defaults shown):
# PORT=8080
# LIGHT_TONE_RATIO=0.003
# LIGHT_NEED_WINDOWS=6
# PROMPT_NCC_THRESHOLD=0.75
# SILENCE_TIMEOUT_MS=15000
# SESSION_TIMEOUT_MS=600000
# HEARTBEAT_MS=30000
# MAX_BODY_BYTES=65536
